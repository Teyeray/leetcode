function parseCsvLine(line) {
  const parts = [];
  let current = '';
  let inQuotes = false;
  for (let i = 0; i < line.length; i++) {
    const ch = line[i];
    if (ch === '"') {
      inQuotes = !inQuotes;
      continue;
    }
    if (ch === ',' && !inQuotes) {
      parts.push(current);
      current = '';
    } else {
      current += ch;
    }
  }
  parts.push(current);
  return parts;
}

function computeScatterRange(data) {
  if (!data.length) return { min: 10, max: 28 };
  const vals = [];
  data.forEach(d => {
    vals.push(d.observed, d.predicted);
  });
  const minV = Math.min(...vals);
  const maxV = Math.max(...vals);
  const pad = Math.max(0.4, (maxV - minV) * 0.08);
  return { min: minV - pad, max: maxV + pad };
}

function buildResidualBinsFromData(data) {
  const edges = [-Infinity, -1.5, -1.0, -0.5, 0, 0.5, 1.0, 1.5, Infinity];
  const labels = ['< -1.5', '-1.5 ~ -1.0', '-1.0 ~ -0.5', '-0.5 ~ 0', '0 ~ 0.5', '0.5 ~ 1.0', '1.0 ~ 1.5', '> 1.5'];
  const counts = new Array(8).fill(0);
  data.forEach(d => {
    const r = d.residual;
    for (let i = 0; i < counts.length; i++) {
      if (r >= edges[i] && r < edges[i + 1]) {
        counts[i] += 1;
        break;
      }
    }
  });
  return labels.map((label, idx) => ({ label, value: counts[idx] }));
}

async function loadScatterDataFromCsv() {
  try {
    const resp = await fetch(CSV_FILE);
    if (!resp.ok) throw new Error('csv fetch failed');
    const text = await resp.text();
    const lines = text.split(/\r?\n/).filter(line => line.trim().length > 0);
    if (lines.length < 2) throw new Error('csv has no content');
    const header = parseCsvLine(lines[0]);
    const oldIdx = header.findIndex(h => h.trim().toLowerCase() === 'old_pce');
    const newIdx = header.findIndex(h => h.trim().toLowerCase() === 'new_pce');
    if (oldIdx < 0 || newIdx < 0) throw new Error('old_pce/new_pce not found');

    const parsed = [];
    const maxRows = 4000;
    for (let i = 1; i < lines.length && parsed.length < maxRows; i++) {
      const cols = parseCsvLine(lines[i]);
      const oldVal = parseFloat(cols[oldIdx]);
      const newVal = parseFloat(cols[newIdx]);
      if (Number.isFinite(oldVal) && Number.isFinite(newVal)) {
        parsed.push({
          observed: oldVal,
          predicted: newVal,
          residual: newVal - oldVal
        });
      }
    }
    if (parsed.length < 50) throw new Error('too few valid rows');

    const targetN = 520;
    const step = Math.max(1, Math.floor(parsed.length / targetN));
    const sampled = [];
    for (let i = 0; i < parsed.length; i += step) {
      sampled.push(parsed[i]);
      if (sampled.length >= targetN) break;
    }
    return sampled;
  } catch (e) {
    return generateFallbackScatterData();
  }
}

