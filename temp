      <div class="cl-title">组装视图</div>
      <div class="cl-item"><div class="cl-dot" style="background:#00e5ff"></div><div class="cl-label">SMILES 双输入</div><div class="cl-count">SMILES1/2</div></div>
      <div class="cl-item"><div class="cl-dot" style="background:#00e676"></div><div class="cl-label">composition_vector</div><div class="cl-count">13 维</div></div>
      <div class="cl-item"><div class="cl-dot" style="background:#ffe066"></div><div class="cl-label">pce_control</div><div class="cl-count">1 维</div></div>
      <div class="cl-item"><div class="cl-dot" style="background:#7b61ff"></div><div class="cl-label">特征拼接</div><div class="cl-count">X_total</div></div>
    `;
    return;
  }
  if (currentView === 'scatter') {
    box.innerHTML = `
      <div class="cl-title">散点图例</div>
      <div class="cl-item"><div class="cl-dot" style="background:#ffe066"></div><div class="cl-label">预测点</div><div class="cl-count">${scatterData.length}</div></div>
      <div class="cl-item"><div class="cl-dot" style="background:#00e5ff"></div><div class="cl-label">y = x 参考线</div><div class="cl-count">ideal</div></div>
      <div class="cl-item"><div class="cl-dot" style="background:#ff4757"></div><div class="cl-label">高残差样本</div><div class="cl-count">outlier</div></div>
      <div class="cl-item"><div class="cl-dot" style="background:#00e676"></div><div class="cl-label">数据源</div><div class="cl-count">old_pce/new_pce</div></div>
    `;
    return;
  }
  if (currentView === 'residual') {
    box.innerHTML = `
      <div class="cl-title">残差说明</div>
      <div class="cl-item"><div class="cl-dot" style="background:#00e676"></div><div class="cl-label">中心区域</div><div class="cl-count">主流样本</div></div>
      <div class="cl-item"><div class="cl-dot" style="background:#ffd600"></div><div class="cl-label">中等偏差</div><div class="cl-count">需要复查</div></div>
      <div class="cl-item"><div class="cl-dot" style="background:#ff4757"></div><div class="cl-label">长尾误差</div><div class="cl-count">少量样本</div></div>
    `;
    return;
  }
  box.innerHTML = `
    <div class="cl-title">重要度图例</div>
    <div class="cl-item"><div class="cl-dot" style="background:#ffe066"></div><div class="cl-label">pce_control</div><div class="cl-count">baseline</div></div>
    <div class="cl-item"><div class="cl-dot" style="background:#00e676"></div><div class="cl-label">comp_vals</div><div class="cl-count">composition</div></div>
    <div class="cl-item"><div class="cl-dot" style="background:#00e5ff"></div><div class="cl-label">gnn_emb</div><div class="cl-count">DMPNN</div></div>
    <div class="cl-item"><div class="cl-dot" style="background:#7b61ff"></div><div class="cl-label">unimol_emb</div><div class="cl-count">Uni-Mol</div></div>
    <div class="cl-item"><div class="cl-dot" style="background:#ff9500"></div><div class="cl-label">当前选中特征</div><div class="cl-count">focus</div></div>
  `;
}

function resizeCanvas() {
  const wrap = mainCanvas.parentElement;
  mainCanvas.width = wrap.clientWidth * window.devicePixelRatio;
  mainCanvas.height = wrap.clientHeight * window.devicePixelRatio;
  mainCanvas.style.width = wrap.clientWidth + 'px';
  mainCanvas.style.height = wrap.clientHeight + 'px';
  mainCtx.setTransform(window.devicePixelRatio, 0, 0, window.devicePixelRatio, 0, 0);
  drawCurrentView();
}

function clearCanvas() {
  mainCtx.clearRect(0, 0, mainCanvas.clientWidth, mainCanvas.clientHeight);
}

function drawAxes(bounds, xLabel, yLabel) {
  const { left, right, top, bottom } = bounds;
  mainCtx.strokeStyle = 'rgba(0,168,255,0.18)';
  mainCtx.lineWidth = 1;
  mainCtx.beginPath();
  mainCtx.moveTo(left, bottom);
  mainCtx.lineTo(right, bottom);
  mainCtx.moveTo(left, top);
  mainCtx.lineTo(left, bottom);
  mainCtx.stroke();
  mainCtx.fillStyle = 'rgba(122,179,212,0.75)';
  mainCtx.font = '11px sans-serif';
  mainCtx.fillText(xLabel, right - 45, bottom + 26);
  mainCtx.save();
  mainCtx.translate(left - 30, top + 36);
  mainCtx.rotate(-Math.PI / 2);
  mainCtx.fillText(yLabel, 0, 0);
  mainCtx.restore();
}

function drawAssembly() {
  clearCanvas();
  const W = mainCanvas.clientWidth;
  const H = mainCanvas.clientHeight;
  const cards = [
    { x: 70, y: 82, w: 210, h: 92, title: '分子输入', sub: 'SMILES1 + SMILES2\n分子合法性校验', color: '#00e5ff' },
    { x: 70, y: 228, w: 210, h: 92, title: '结构嵌入', sub: 'Uni-Mol + DMPNN\n得到 embedding 特征', color: '#7b61ff' },
    { x: 70, y: 374, w: 210, h: 92, title: '器件与组分', sub: 'composition_vector (13)\npce_control + device_structure', color: '#00e676' },
    { x: 342, y: 156, w: 246, h: 112, title: '特征拼接 X_total', sub: '[embedding_1, embedding_2, comp_vals,\npce_control, device_structure, morgan_fp]', color: '#ffe066' },
    { x: 342, y: 330, w: 246, h: 112, title: 'Seed = 49 切分', sub: 'Train: 前 248\nTest: 其余样本', color: '#ff9500' },
    { x: 644, y: 238, w: 224, h: 126, title: 'RandomForest', sub: 'n_estimators=200\nmax_depth=16\n输出预测与重要性', color: '#00a8ff' }
  ];

  const scale = Math.min(1.05, Math.max(0.75, (W - 40) / 930));
  mainCtx.save();
  mainCtx.translate((W - 930 * scale) / 2, (H - 560 * scale) / 2);
  mainCtx.scale(scale * zoomScale, scale * zoomScale);

  cards.forEach(card => {
    mainCtx.fillStyle = 'rgba(6,20,40,0.92)';
    mainCtx.strokeStyle = card.color;
    mainCtx.lineWidth = 1.4;
    mainCtx.beginPath();
    mainCtx.roundRect(card.x, card.y, card.w, card.h, 10);
    mainCtx.fill();
    mainCtx.stroke();

    mainCtx.fillStyle = card.color;
    mainCtx.font = 'bold 14px sans-serif';
    mainCtx.fillText(card.title, card.x + 12, card.y + 24);

    mainCtx.fillStyle = 'rgba(122,179,212,0.9)';
    mainCtx.font = '12px sans-serif';
    const lines = card.sub.split('\n');
    lines.forEach((line, idx) => {
      mainCtx.fillText(line, card.x + 12, card.y + 48 + idx * 18);
    });
  });

  function arrow(x1, y1, x2, y2, c) {
    mainCtx.strokeStyle = c;
    mainCtx.lineWidth = 2;
    mainCtx.beginPath();
    mainCtx.moveTo(x1, y1);
    mainCtx.lineTo(x2, y2);
    mainCtx.stroke();
    const angle = Math.atan2(y2 - y1, x2 - x1);
    mainCtx.beginPath();
    mainCtx.moveTo(x2, y2);
    mainCtx.lineTo(x2 - 12 * Math.cos(angle - 0.32), y2 - 12 * Math.sin(angle - 0.32));
    mainCtx.lineTo(x2 - 12 * Math.cos(angle + 0.32), y2 - 12 * Math.sin(angle + 0.32));
    mainCtx.closePath();
    mainCtx.fillStyle = c;
    mainCtx.fill();
  }

  arrow(280, 128, 342, 208, '#00e5ff');
  arrow(280, 274, 342, 222, '#7b61ff');
  arrow(280, 420, 342, 236, '#00e676');
  arrow(588, 212, 644, 282, '#ffe066');
  arrow(588, 386, 644, 322, '#ff9500');

  mainCtx.restore();

  mainCtx.fillStyle = 'rgba(122,179,212,0.72)';
  mainCtx.font = '11px sans-serif';
  mainCtx.fillText('数据组装视图：从分子输入到特征拼接与随机森林训练入口', 22, 24);
}

function drawScatter() {
  clearCanvas();
  const W = mainCanvas.clientWidth;
  const H = mainCanvas.clientHeight;
  const bounds = { left: 70, right: W - 54, top: 40, bottom: H - 60 };
  drawAxes(bounds, 'Observed PCE', 'Predicted PCE');

  const min = scatterRange.min;
  const max = scatterRange.max;
  const scaleX = v => bounds.left + ((v - min) / (max - min)) * (bounds.right - bounds.left) * zoomScale;
  const scaleY = v => bounds.bottom - ((v - min) / (max - min)) * (bounds.bottom - bounds.top) * zoomScale;

  mainCtx.strokeStyle = 'rgba(0,229,255,0.6)';
  mainCtx.lineWidth = 1.5;
  mainCtx.beginPath();
  mainCtx.moveTo(scaleX(min), scaleY(min));
  mainCtx.lineTo(scaleX(max), scaleY(max));
  mainCtx.stroke();

  hoveredDatum = null;
  scatterData.forEach((point, idx) => {
    const x = scaleX(point.observed);
    const y = scaleY(point.predicted);
    const radius = Math.abs(point.residual) > 1.2 ? 4.8 : 3.0;
    const color = Math.abs(point.residual) > 1.2 ? '#ff4757' : Math.abs(point.residual) > 0.7 ? '#ffd600' : '#00e676';
    mainCtx.beginPath();
    mainCtx.arc(x, y, radius, 0, Math.PI * 2);
    mainCtx.fillStyle = color;
    mainCtx.globalAlpha = 0.82;
    mainCtx.fill();
    mainCtx.globalAlpha = 1;
    if (idx % 10 === 0) {
      mainCtx.strokeStyle = 'rgba(255,255,255,0.35)';
      mainCtx.lineWidth = 1;
      mainCtx.stroke();
    }
  });

  mainCtx.fillStyle = 'rgba(122,179,212,0.72)';
  mainCtx.font = '11px sans-serif';
  mainCtx.fillText('Observed PCE (x) vs Predicted PCE (y) · Test Set', bounds.left, 22);
}

function drawResidual() {
  clearCanvas();
  const W = mainCanvas.clientWidth;
  const H = mainCanvas.clientHeight;
  const bounds = { left: 56, right: W - 42, top: 40, bottom: H - 60 };
  drawAxes(bounds, 'Residual Bin', 'Count');

  const maxCount = Math.max(...residualBins.map(item => item.value));
  const innerWidth = bounds.right - bounds.left;
  const barWidth = innerWidth / residualBins.length - 12;

  residualBins.forEach((bin, index) => {
    const x = bounds.left + index * (innerWidth / residualBins.length) + 6;
    const height = (bin.value / maxCount) * (bounds.bottom - bounds.top) * zoomScale;
    const y = bounds.bottom - height;
    const color = index >= 2 && index <= 5 ? '#00e676' : index === 1 || index === 6 ? '#ffd600' : '#ff4757';
    mainCtx.fillStyle = color;
    mainCtx.globalAlpha = 0.82;
    mainCtx.fillRect(x, y, barWidth, height);
    mainCtx.globalAlpha = 1;
    mainCtx.fillStyle = 'rgba(122,179,212,0.72)';
    mainCtx.font = '9px sans-serif';
    mainCtx.textAlign = 'center';
    mainCtx.fillText(bin.label, x + barWidth / 2, bounds.bottom + 16);
    mainCtx.fillText(bin.value, x + barWidth / 2, y - 8);
  });
  mainCtx.textAlign = 'left';
  mainCtx.fillStyle = 'rgba(122,179,212,0.72)';
  mainCtx.font = '11px sans-serif';
  mainCtx.fillText('Residual concentration remains centered around zero', bounds.left, 22);
}

function drawImportance() {
  clearCanvas();
  const W = mainCanvas.clientWidth;
  const H = mainCanvas.clientHeight;
  const padT = 38, padB = 12;
  const labelZone = Math.min(264, Math.floor(W * 0.40));
  const barLeft = labelZone + 8;
  const barRight = W - 72;
  const visible = FEATURE_IMPORTANCE.slice(0, 12);
  const rowH = Math.floor((H - padT - padB) / visible.length);
  const maxValue = visible[0].importance;

  // Header
  mainCtx.fillStyle = 'rgba(122,179,212,0.72)';
  mainCtx.font = '11px sans-serif';
  mainCtx.textAlign = 'left';
  mainCtx.fillText('Top 12 feature importance · RandomForest', 14, 22);

  // Divider between label zone and bar zone
  mainCtx.strokeStyle = 'rgba(0,168,255,0.10)';
  mainCtx.lineWidth = 1;
  mainCtx.beginPath();
  mainCtx.moveTo(labelZone + 4, padT - 4);
  mainCtx.lineTo(labelZone + 4, H - padB);
  mainCtx.stroke();

  visible.forEach((item, index) => {
    const rowY = padT + index * rowH;
    const meta = describeFeature(item);
    const isActive = selectedFeature.rank === item.rank;
    const barW = Math.max(((item.importance / maxValue) * (barRight - barLeft)) * zoomScale, 2);
    const barY = rowY + Math.round(rowH * 0.30);
    const barH = Math.round(rowH * 0.36);

    // Row background
    if (isActive) {
      mainCtx.fillStyle = 'rgba(255,149,0,0.09)';
      mainCtx.fillRect(0, rowY + 1, W, rowH - 2);
    } else if (index % 2 === 0) {
      mainCtx.fillStyle = 'rgba(255,255,255,0.018)';
      mainCtx.fillRect(0, rowY + 1, W, rowH - 2);
    }

    // Rank badge
    mainCtx.textAlign = 'right';
    mainCtx.font = 'bold 10px sans-serif';
    mainCtx.fillStyle = isActive ? '#ff9500' : 'rgba(122,179,212,0.50)';
    mainCtx.fillText(`#${item.rank}`, 26, rowY + Math.round(rowH * 0.46));

    // Feature title — truncated to fit label zone
    mainCtx.textAlign = 'left';
    mainCtx.font = (isActive ? 'bold ' : '') + '11px sans-serif';
    mainCtx.fillStyle = isActive ? '#ffd580' : '#e8f4ff';
    let title = meta.title;
    const maxTW = labelZone - 36;
    while (title.length > 4 && mainCtx.measureText(title).width > maxTW) title = title.slice(0, -1);
    if (title !== meta.title) title = title.slice(0, -2) + '…';
    mainCtx.fillText(title, 32, rowY + Math.round(rowH * 0.42));

    // Module sub-label
    mainCtx.font = '9px sans-serif';
    mainCtx.fillStyle = 'rgba(122,179,212,0.58)';
    mainCtx.fillText(MODULE_DISPLAY[item.module], 32, rowY + Math.round(rowH * 0.76));

    // Bar
    mainCtx.fillStyle = item.color + (isActive ? 'dd' : '88');
    mainCtx.fillRect(barLeft, barY, barW, barH);
    if (isActive) {
      mainCtx.strokeStyle = '#ff9500';
      mainCtx.lineWidth = 1;
      mainCtx.strokeRect(barLeft, barY, barW, barH);
    }

    // Value label to the right of bar
    mainCtx.textAlign = 'left';
    mainCtx.font = 'bold 10px sans-serif';
    mainCtx.fillStyle = isActive ? '#ff9500' : '#ffe066';
    const valX = Math.min(barLeft + barW + 6, barRight + 4);
    mainCtx.fillText(item.importance.toFixed(4), valX, rowY + Math.round(rowH * 0.52));
  });

  mainCtx.textAlign = 'left';
}

function drawCurrentView() {
  buildLegend();
  if (currentView === 'assembly') drawAssembly();
  else if (currentView === 'scatter') drawScatter();
  else if (currentView === 'residual') drawResidual();
  else drawImportance();
}

function setView(view, btn) {
  currentView = view;
  document.querySelectorAll('.ctrl-btn').forEach(node => node.classList.remove('active'));
  if (btn) btn.classList.add('active');
  if (view !== 'importance') document.getElementById('selectedPanel').classList.remove('visible');
  document.getElementById('viewTag').textContent = view === 'assembly' ? '数据组装' : view === 'scatter' ? '预测散点' : view === 'residual' ? '残差分布' : '特征重要性';
  document.getElementById('vizTitle').textContent = view === 'scatter'
    ? 'RandomForest 预测性能总览'
    : view === 'assembly'
    ? '数据组装与建模输入结构'
    : view === 'residual'
    ? '测试集残差分布'
    : 'RandomForest 特征重要性排名';
  document.getElementById('vizSub').textContent = view === 'scatter'
    ? '直接使用 chemicalbook CSV 中 old_pce/new_pce 的真实数值绘制散点'
    : view === 'assembly'
    ? '展示 notebook 数据处理部分如何组装输入特征并送入 RandomForest'
    : view === 'residual'
    ? '围绕 0 对称的残差柱状分布，反映模型误差主要集中在中低偏差区间'
    : '根据用户提供的 Top 19 特征重要性构建，可点击右侧条目查看中文解释';
  drawCurrentView();
}

function zoom(factor) {
  zoomScale = Math.min(1.8, Math.max(0.72, zoomScale * factor));
  drawCurrentView();
}

function resetView() {
  zoomScale = 1;
  drawCurrentView();
}

function getResp(text) {
  if (text.includes('pce_control') || text.includes('基线') || text.includes('未添加钝化剂')) return RF_RESP.pce_control;
  if (text.includes('comp_vals') || text.includes('组分') || text.includes('FA') || text.includes('MA') || text.includes('I')) return RF_RESP.comp_vals;
  if (text.includes('DMPNN') || text.includes('Uni-Mol') || text.includes('embedding')) return RF_RESP.embedding;
  if (text.includes('误差') || text.includes('R2') || text.includes('MAE') || text.includes('RMSE')) return RF_RESP.metric;
  return {
    think: '正在整理当前随机森林页面信息...',
    reply: '当前页面聚焦 <span class="tag">RandomForest</span> 结果展示：左侧是数据处理流程，中间可切换 <span class="btag">预测散点 / 残差分布 / 特征重要性</span>，右侧给出核心指标和 Top 特征列表。您可以继续追问某个特征或某类模块的含义。'
  };
}

function typewrite(role, html) {
  const container = document.getElementById('chatMessages');
  const msg = document.createElement('div');
  msg.className = 'chat-msg';
  const roleEl = document.createElement('span');
  roleEl.className = `msg-role ${role}`;
  roleEl.textContent = role === 'user' ? '用户' : 'Agent';
  const textEl = document.createElement('span');
  textEl.className = 'msg-text';
  msg.appendChild(roleEl);
  msg.appendChild(textEl);
  container.appendChild(msg);
  const plain = html.replace(/<[^>]+>/g, '');
  let i = 0;
  const timer = setInterval(() => {
    i += 4;
    if (i >= plain.length) {
      clearInterval(timer);
      textEl.innerHTML = html;
    } else {
      textEl.textContent = plain.slice(0, i);
    }
    container.scrollTop = container.scrollHeight;
  }, 16);
}

function addMsg(role, html) {
  const container = document.getElementById('chatMessages');
  const msg = document.createElement('div');
  msg.className = 'chat-msg';
  msg.innerHTML = `<span class="msg-role ${role}">${role === 'user' ? '用户' : 'Agent'}</span><span class="msg-text">${html}</span>`;
  container.appendChild(msg);
  container.scrollTop = container.scrollHeight;
}

function sendMessage() {
  const input = document.getElementById('chatInput');
  const text = input.value.trim();
  if (!text) return;
  input.value = '';
  addMsg('user', text);
  const resp = getResp(text);
  const thinking = document.getElementById('agentThinking');
  document.getElementById('thinkingText').textContent = resp.think;
  thinking.classList.add('visible');
  setTimeout(() => {
    thinking.classList.remove('visible');
    typewrite('agent', resp.reply);
  }, 1100);
}

function usePreset(btn) {
  const text = btn.textContent.replace(/^[^\s]+\s/, '');
  document.getElementById('chatInput').value = text;
  sendMessage();
}

window.addEventListener('resize', resizeCanvas);

async function init() {
  scatterData = await loadScatterDataFromCsv();
  scatterRange = computeScatterRange(scatterData);
  residualBins = buildResidualBinsFromData(scatterData);
  buildStageList();
  buildModuleCard();
  buildFeatureList();
  resizeCanvas();
  showFeature(FEATURE_IMPORTANCE[0]);
  setView('scatter', document.querySelector('[data-view="scatter"]'));
  document.getElementById('vizLoading').classList.add('hidden');
  setTimeout(() => {
    typewrite('agent', '您好！这里展示的是 <span class="hl">HKAI-PV RandomForest</span> 结果页。左侧展示完整建模流程，中间可切换预测散点、残差分布与特征重要性视图，右侧给出核心性能指标。点击右侧 Top 特征可查看中文释义。');
  }, 600);
}

init();
</script>
